# Environment secrets (NEVER SHARE OR COMMIT)
.env

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Zip archives and backups
*.zip
*.tar.gz
*.bak

# State files & logs (runtime data)
open_positions.json
portfolio_stats.json
trade_history.json
regime_state.json
regime_tape.jsonl
regime_log.txt
guardian_state.json
memgpt_state.json
letta/

# Scratch files
scratch/

# Ignore scratch procedural sounds (>2GB), keep all active sounds
