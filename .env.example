# ==============================================================================
# Solana Pump ML Sniper Bot — Environment Template
# Copy this file to .env and fill in your own keys:
#   cp .env.example .env
# ==============================================================================

# Helius RPC API Key (Get a free key from https://helius.dev)
HELIUS_API_KEY=your_helius_api_key_here

# Solana Wallet Private Key (Base58 encoded)
# REQUIRED if TRADING_MODE=real. Optional if TRADING_MODE=paper
SOLANA_PRIVATE_KEY=your_solana_private_key_base58_here

# Trading Execution Mode: 'paper' (simulated risk-free) or 'real' (live on-chain)
TRADING_MODE=paper

# Trade Execution Parameters
DEFAULT_BUY_AMOUNT_SOL=0.006
TAKE_PROFIT_PCT=50.0
STOP_LOSS_PCT=25.0

# Anti-Rug: Incubated Farmed Wallet Defense (0.30 - 2.0 SOL Dev Buy on 7 - 30 Day Accounts)
BLOCK_INCUBATED_WALLETS=true
INCUBATED_BUY_MIN_SOL=0.30
INCUBATED_BUY_MAX_SOL=2.00
INCUBATED_AGE_MIN_DAYS=7.0
INCUBATED_AGE_MAX_DAYS=30.0
INCUBATED_BLOCK_OUTRIGHT=true
INCUBATED_MIN_TXNS=60

# Amazon Bedrock AI Market Newscast Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
BEDROCK_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
