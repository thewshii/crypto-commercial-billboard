# ==============================================================================
# Solana Pump ML Sniper Bot — Environment Template
# Copy this file to .env and fill in your own keys:
#   cp .env.example .env
# ==============================================================================

# Helius RPC API Key (Get a free key from https://helius.dev)
HELIUS_API_KEY=your_helius_api_key_here

# Solana Wallet Private Key (Base58 encoded)
# REQUIRED if TRADING_MODE=real. Optional if TRADING_MODE=paper
SOLANA_PRIVATE_KEY=your_solana_private_key_base58_here

# Trading Execution Mode: 'paper' (simulated risk-free) or 'real' (live on-chain)
TRADING_MODE=paper

# Trade Execution Parameters
DEFAULT_BUY_AMOUNT_SOL=0.006
TAKE_PROFIT_PCT=50.0
STOP_LOSS_PCT=25.0
